{
  // Builds the vendored, unmodified @dome-security/registry-bindings sources.
  // The generated code is not written for this repository's strict settings,
  // so it gets the settings its own tsconfig.json uses, plus what project
  // references need. Never edit files under registry-bindings/ by hand.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strictNullChecks": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "types": [],
    "rootDir": "registry-bindings/src",
    "outDir": "registry-bindings/dist",
    "tsBuildInfoFile": "registry-bindings/dist/.tsbuildinfo"
  },
  "include": ["registry-bindings/src"]
}

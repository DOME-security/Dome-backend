      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@dome-security/engine": "workspace:*",
    "@dome-security/intel": "workspace:*"
